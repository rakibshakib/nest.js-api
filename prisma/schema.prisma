// 1. migration command to create migration file
// npx prisma migrate dev --name comment 

// 2. run command to generate prisma client
// npx prisma generate

enum UserType {
  ADMIN
  VENDOR
  CUSTOMER
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  phone    String?
  password String
  userType UserType @default(CUSTOMER)

  admin    Admin?
  vendor   Vendor?
  customer Customer?

  createdCategories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
}

model Admin {
  userId Int @id

  role AdminRole @default(MANAGER)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  userId Int @id

  businessName String
  address      String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  userId Int @id

  address String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  status      CategoryStatus @default(ACTIVE)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  status    String   @default("active")
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
