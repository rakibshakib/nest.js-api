// npx prisma generate

enum UserType {
  ADMIN
  VENDOR
  CUSTOMER
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  phone    String?
  password String
  userType UserType @default(CUSTOMER)

  admin    Admin?
  vendor   Vendor?
  customer Customer?

  createdCategories Category[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  notes     Note[]
  services  Service[]
}

model Admin {
  userId Int @id

  role AdminRole @default(MANAGER)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  userId Int @id

  businessName String
  address      String?

  logoUrl  String?
  logoPath String?

  responseTime String? @default("30 Min")
  rating       Decimal @default(0) @db.Decimal(3, 2)

  coverUrl  String?
  coverPath String?

  status   VendorStatus @default(PENDING)
  isActive Boolean      @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vendorCategories VendorCategory[]
  vendorServices   VendorService[]
  vendorOffer      VendorOffer?
}

model Customer {
  userId Int @id

  address  String?
  isActive Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  services         Service[]
  vendorCategories VendorCategory[]
}

model VendorCategory {
  vendorId   Int
  categoryId Int

  vendor   Vendor   @relation(fields: [vendorId], references: [userId], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([vendorId, categoryId])
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  status    String   @default("active")
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Service {
  id               Int     @id @default(autoincrement())
  name             String
  shortDescription String?
  description      String? @db.Text

  basePrice Decimal @db.Decimal(10, 2)

  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  discountType   DiscountType @default(FLAT)

  rating       Decimal @default(0) @db.Decimal(3, 2)
  totalReviews Int     @default(0)

  isActive Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  variations ServiceVariation[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  vendorServices VendorService[]
}

model ServiceVariation {
  id    Int     @id @default(autoincrement())
  name  String
  price Decimal @db.Decimal(10, 2)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorService {
  vendorId  Int
  serviceId Int
  isActive  Boolean @default(true)

  vendor  Vendor  @relation(fields: [vendorId], references: [userId], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([vendorId, serviceId])
}

enum OfferType {
  TEXT
  PERCENTAGE
  FIXED_AMOUNT
}

model VendorOffer {
  id Int @id @default(autoincrement())

  vendorId Int    @unique
  vendor   Vendor @relation(fields: [vendorId], references: [userId], onDelete: Cascade)

  type OfferType

  title       String?
  description String?

  value Decimal? @db.Decimal(10, 2)

  startDate     DateTime
  hasExpireDate Boolean   @default(false)
  endDate       DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
