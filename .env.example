NODE_ENV=development

# PostgreSQL (local)
LOCAL_DB_URL="postgresql://user@localhost:5432/dbname"
DATABASE_URL="postgresql://user@localhost:5432/dbname"

# Local PostgreSQL connection details
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=user
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=dbname

# JWT Secrets
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Mailtrap (SMTP)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password
MAIL_FROM="Multi Vendor Service <no-reply@multivendor.local>"
